{
  "name": "claude-ui",
  "productName": "Claude UI",
  "version": "0.3.0",
  "description": "Desktop UI for managing Claude Code sessions: session list from ~/.claude, pin/group, embedded terminal, waiting-for-input nudges.",
  "license": "MIT",
  "author": "OrthoCode",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc --noEmit -p tsconfig.renderer.json && esbuild src/renderer/renderer.ts --bundle --format=esm --minify --outfile=dist/renderer/renderer.js --sourcemap && cp src/renderer/index.html assets/icon.png dist/renderer/",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron . --no-sandbox",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run",
    "test:watch": "vitest",
    "test:renderer": "npm run build && playwright test -c test/renderer",
    "styles:compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/renderer/styles/compare.ts",
    "lint": "eslint .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.1.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "air-datepicker": "^3.6.0",
    "markdown-it": "^15.0.2",
    "node-pty": "^1.1.0",
    "sortablejs": "^1.15.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
